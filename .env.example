# InventoryTW - Environment variables
# Copy to .env.local and fill values as needed.

# --- Email reminders (SMTP) ---
# Required (minimum) to enable "Enviar recordatorio" in Clientes/Proveedores:
SMTP_HOST=
SMTP_FROM=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_DEFAULT_CC=
SMTP_TLS_REJECT_UNAUTHORIZED=true

# --- Optional diagnostics ---
# Enable Amplify Data tracing on server (dev only)
AMPLIFY_TRACE=0

# --- Adaptive AI assistant (LLM) on AWS Bedrock ---
# Primary reasoning model (recommended): Claude 3.5 Sonnet
AI_MODEL_PRIMARY=anthropic.claude-3-5-sonnet-20240620-v1:0
# Fast classifier model for simple routing/intents
AI_MODEL_FAST=amazon.nova-micro-v1:0
# Back-compat fallback model variable (optional)
AI_MODEL=
# Bedrock region where the model is enabled.
AI_BEDROCK_REGION=us-east-2

# --- Printing / labels (optional) ---
NEXT_PUBLIC_ZEBRA_DPI=203
# Zebra darkness (0-30). Higher = darker. Typical range 15-30.
NEXT_PUBLIC_ZEBRA_DARKNESS=25
NEXT_PUBLIC_BROWSERPRINT_PORT=9101
# NEXT_PUBLIC_BROWSERPRINT_SDK_URL=
# NEXT_PUBLIC_BROWSERPRINT_SDK_URLS=
