# InventoryTW - Environment variables
# Copy to .env.local and fill values as needed.

# --- Email reminders (SMTP) ---
# Required (minimum) to enable "Enviar recordatorio" in Clientes/Proveedores:
SMTP_HOST=
SMTP_FROM=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_DEFAULT_CC=
SMTP_TLS_REJECT_UNAUTHORIZED=true

# --- Optional diagnostics ---
# Enable Amplify Data tracing on server (dev only)
AMPLIFY_TRACE=0

# --- AWS Bedrock - Asistente IA (server-side API route) ---
# IMPORTANTE: Este sistema usa auth propio (session cookies), NO Cognito User Auth.
# Por eso el API route /api/ai/chat necesita credenciales IAM estáticas para llamar a Bedrock.
#
# Pasos para obtenerlas:
# 1. Ve a AWS IAM Console → Users → Create user (ej: "inventorytw-bedrock-api")
# 2. Permisos: policy inline solo con bedrock:InvokeModel sobre los modelos de Claude
# 3. Genera Access Key → copia los valores abajo
# 4. En Amplify Console: App → Environment variables → agrega las mismas variables
#
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
# Región donde tienes habilitados los modelos de Claude (us-east-1 o us-east-2)
AI_BEDROCK_REGION=us-east-2
# Modelo preferido. Claude 3 Haiku es el más económico. Claude 3.5 Sonnet el más capaz.
# Para activar: AWS Console → Bedrock → Model access → habilitar el modelo
AI_MODEL_PRIMARY=anthropic.claude-3-haiku-20240307-v1:0
# AI_MODEL_PRIMARY=anthropic.claude-3-5-sonnet-20240620-v1:0
AI_MAX_TOKENS=1024

# --- Printing / labels (optional) ---
NEXT_PUBLIC_ZEBRA_DPI=203
# Zebra darkness (0-30). Higher = darker. Typical range 15-30.
NEXT_PUBLIC_ZEBRA_DARKNESS=25
NEXT_PUBLIC_BROWSERPRINT_PORT=9101
# NEXT_PUBLIC_BROWSERPRINT_SDK_URL=
# NEXT_PUBLIC_BROWSERPRINT_SDK_URLS=
